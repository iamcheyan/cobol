       IDENTIFICATION DIVISION.
       PROGRAM-ID. BANK-MATCH-L3.
       ENVIRONMENT DIVISION.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT ACCOUNT-IN ASSIGN TO DYNAMIC ACCOUNT-PATH
               ORGANIZATION IS LINE SEQUENTIAL
               FILE STATUS IS ACCOUNT-STATUS.
           SELECT MASTER-IN ASSIGN TO DYNAMIC MASTER-PATH
               ORGANIZATION IS LINE SEQUENTIAL
               FILE STATUS IS MASTER-STATUS.
           SELECT TX-IN ASSIGN TO DYNAMIC TX-PATH
               ORGANIZATION IS LINE SEQUENTIAL
               FILE STATUS IS TX-STATUS.
           SELECT SNAP-RAW ASSIGN TO DYNAMIC SNAP-PATH
               ORGANIZATION IS SEQUENTIAL
               FILE STATUS IS SNAP-STATUS.
           SELECT PREV-RAW ASSIGN TO DYNAMIC PREV-PATH
               ORGANIZATION IS SEQUENTIAL
               FILE STATUS IS PREV-STATUS.
           SELECT REJECT-RAW ASSIGN TO DYNAMIC L2-REJECT-PATH
               ORGANIZATION IS SEQUENTIAL
               FILE STATUS IS REJECT-STATUS.
           SELECT SNAP-NORMAL ASSIGN TO DYNAMIC SNAP-NORMAL-PATH
               ORGANIZATION IS LINE SEQUENTIAL
               FILE STATUS IS SNAP-NORMAL-STATUS.
           SELECT PREV-NORMAL ASSIGN TO DYNAMIC PREV-NORMAL-PATH
               ORGANIZATION IS LINE SEQUENTIAL
               FILE STATUS IS PREV-NORMAL-STATUS.
           SELECT ACCOUNT-WORK ASSIGN TO SORT-WORK.
           SELECT TX-WORK ASSIGN TO SORT-WORK.
           SELECT ACCOUNT-FEED ASSIGN TO DYNAMIC ACCOUNT-FEED-PATH
               ORGANIZATION IS LINE SEQUENTIAL
               FILE STATUS IS ACCOUNT-FEED-STATUS.
           SELECT TX-FEED ASSIGN TO DYNAMIC TX-FEED-PATH
               ORGANIZATION IS LINE SEQUENTIAL
               FILE STATUS IS TX-FEED-STATUS.
           SELECT ACCOUNT-CUSTOMER-IN
               ASSIGN TO DYNAMIC ACCOUNT-FEED-PATH
               ORGANIZATION IS LINE SEQUENTIAL
               FILE STATUS IS ACCOUNT-CUSTOMER-STATUS.
           SELECT TX-CUSTOMER-IN ASSIGN TO DYNAMIC TX-FEED-PATH
               ORGANIZATION IS LINE SEQUENTIAL
               FILE STATUS IS TX-CUSTOMER-STATUS.
           SELECT CUSTOMER-SNAPSHOT-IN
               ASSIGN TO DYNAMIC SNAP-NORMAL-PATH
               ORGANIZATION IS LINE SEQUENTIAL
               FILE STATUS IS SNAPSHOT-IN-STATUS.
           SELECT PREVIOUS-DAY-IN ASSIGN TO DYNAMIC PREV-NORMAL-PATH
               ORGANIZATION IS LINE SEQUENTIAL
               FILE STATUS IS PREVIOUS-IN-STATUS.
           SELECT GROUP-SPOOL ASSIGN TO DYNAMIC SPOOL-PATH
               ORGANIZATION IS SEQUENTIAL
               FILE STATUS IS SPOOL-STATUS.
           SELECT ELIGIBLE-MASTER ASSIGN TO DYNAMIC ELIGIBLE-MASTER-PATH
               ORGANIZATION IS LINE SEQUENTIAL
               FILE STATUS IS ELIGIBLE-MASTER-STATUS.
           SELECT ELIGIBLE-TX ASSIGN TO DYNAMIC ELIGIBLE-TX-PATH
               ORGANIZATION IS LINE SEQUENTIAL
               FILE STATUS IS ELIGIBLE-TX-STATUS.
           SELECT CUSTOMER-TOTALS ASSIGN TO DYNAMIC TOTALS-PATH
               ORGANIZATION IS LINE SEQUENTIAL
               FILE STATUS IS TOTALS-STATUS.
           SELECT CUSTOMER-STATUS-OUT ASSIGN TO DYNAMIC STATUS-PATH
               ORGANIZATION IS LINE SEQUENTIAL
               FILE STATUS IS STATUS-OUT-STATUS.
           SELECT ISOLATION-OUT ASSIGN TO DYNAMIC ISOLATION-PATH
               ORGANIZATION IS LINE SEQUENTIAL
               FILE STATUS IS ISOLATION-STATUS.
           SELECT CONTROL-OUT ASSIGN TO DYNAMIC CONTROL-PATH
               ORGANIZATION IS LINE SEQUENTIAL
               FILE STATUS IS CONTROL-STATUS.
