      *> M04COPY: module 04 lesson 04.2 COPY REPLACING レイアウト
      *> module 07 正規 enterprise copybook 再利用（読取専用
       IDENTIFICATION DIVISION.
       PROGRAM-ID. M04COPY.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 ENT-V1.
          COPY 'ENTERPRISE-CUSTOMER-V1.CPY'.
       01 ENT-V2.
          COPY 'ENTERPRISE-CUSTOMER-V1.CPY'
            REPLACING ==CUSTOMER-CLASSIFICATION PIC X(1)==
                      BY ==CUSTOMER-CLASSIFICATION PIC X(2)==.
       01 WS-N PIC 9(4).
       01 WS-M PIC 9(4).
       01 WS-FIRST4 PIC X(4).
       01 WS-LAST6 PIC X(6).
       01 WS-CLASS PIC X(2).
       01 WS-ID PIC X(10).
       PROCEDURE DIVISION.
       1000-MAIN.
           DISPLAY 'LESSON,04.2'
           MOVE LENGTH OF ENT-V1 TO WS-N
           DISPLAY 'LEN,V1,' WS-N
           MOVE LENGTH OF ENT-V2 TO WS-M
           DISPLAY 'LEN,V2,' WS-M
           SUBTRACT WS-N FROM WS-M
           DISPLAY 'SHIFT,V2-V1,' WS-M
           MOVE 'A' TO CUSTOMER-CLASSIFICATION OF ENT-V1
           MOVE 'B' TO CUSTOMER-CLASSIFICATION OF ENT-V2
           MOVE CUSTOMER-CLASSIFICATION OF ENT-V1 TO WS-CLASS
           DISPLAY 'CLASSIFICATION,V1,' FUNCTION TRIM(WS-CLASS)
           MOVE CUSTOMER-CLASSIFICATION OF ENT-V2 TO WS-CLASS
           DISPLAY 'CLASSIFICATION,V2,' FUNCTION TRIM(WS-CLASS)
           MOVE '0000000001' TO CUSTOMER-ID OF ENT-V1
           MOVE CUSTOMER-ID OF ENT-V1 TO WS-ID
           MOVE WS-ID(1:4) TO WS-FIRST4
           MOVE WS-ID(5:6) TO WS-LAST6
           DISPLAY 'REFMOD,CUSTOMER-ID,FIRST4,' WS-FIRST4
           DISPLAY 'REFMOD,CUSTOMER-ID,LAST6,' WS-LAST6
           GOBACK.
