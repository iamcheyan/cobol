       IDENTIFICATION DIVISION.
       PROGRAM-ID. IFACEPROBE.
      *    Unit experiment for module 09. Prints deterministic evidence
      *    for BY REFERENCE / BY CONTENT / BY VALUE, static vs INITIAL
      *    WORKING-STORAGE, and AMTCALC interface/RC handling.
      *    Run: build.sh ifaceprobe.COB, then ./ifaceprobe
       DATA DIVISION.
       WORKING-STORAGE SECTION.
           COPY "AMTCALC-INTERFACE-V1.CPY".
       01 WS-A PIC X(5) VALUE 'AAAAA'.
       01 WS-N PIC S9(9) COMP-5 VALUE 42.
       01 WS-R PIC 9(4).
       01 WS-RC PIC 9(2) COMP-5.
       PROCEDURE DIVISION.
       0000-BYRUN.
           CALL 'BYREF-SUB' USING WS-A
           DISPLAY 'BY-REF     AFTER=' WS-A
           CALL 'BYCTR-SUB' USING BY CONTENT WS-A
           DISPLAY 'BY-CONTENT AFTER=' WS-A
           DISPLAY 'BY-VALUE   N-BEFORE=' WS-N
           CALL 'VAL-SUB' USING BY VALUE WS-N
           DISPLAY 'BY-VALUE   N-AFTER=' WS-N
           CALL 'STATIC-ACC' USING WS-R
           DISPLAY 'STATIC     CALL1=' WS-R
           CALL 'STATIC-ACC' USING WS-R
           DISPLAY 'STATIC     CALL2=' WS-R
           CALL 'INIT-ACC' USING WS-R
           DISPLAY 'INITIAL    CALL1=' WS-R
           CALL 'INIT-ACC' USING WS-R
           DISPLAY 'INITIAL    CALL2=' WS-R
           PERFORM 1000-AMT-OK
           PERFORM 2000-AMT-VERSION
           PERFORM 3000-AMT-LENGTH
           PERFORM 4000-AMT-BUSINESS
           GOBACK.
       1000-SETUP.
           MOVE LENGTH OF AMT-CALC-INTERFACE TO AMT-IFACE-LENGTH
           MOVE '001' TO AMT-IFACE-VERSION
           MOVE 'PST' TO AMT-IFACE-OP
           MOVE 'C' TO AMT-DIRECTION
           MOVE '0000000000500' TO AMT-AMOUNT-IN
           MOVE 1000 TO AMT-BALANCE
           MOVE SPACES TO AMT-REASON.
       1000-AMT-OK.
           PERFORM 1000-SETUP
           CALL 'AMTCALC' USING AMT-CALC-INTERFACE RETURNING WS-RC
           DISPLAY 'AMT-OK     RC=' WS-RC ' BAL=' AMT-BALANCE
             ' REASON=' FUNCTION TRIM(AMT-REASON).
       2000-AMT-VERSION.
           PERFORM 1000-SETUP
           MOVE '002' TO AMT-IFACE-VERSION
           CALL 'AMTCALC' USING AMT-CALC-INTERFACE RETURNING WS-RC
           DISPLAY 'AMT-VER    RC=' WS-RC
             ' REASON=' FUNCTION TRIM(AMT-REASON).
       3000-AMT-LENGTH.
           PERFORM 1000-SETUP
           MOVE 1 TO AMT-IFACE-LENGTH
           CALL 'AMTCALC' USING AMT-CALC-INTERFACE RETURNING WS-RC
           DISPLAY 'AMT-LEN    RC=' WS-RC
             ' REASON=' FUNCTION TRIM(AMT-REASON).
       4000-AMT-BUSINESS.
           PERFORM 1000-SETUP
           MOVE '0000000000000' TO AMT-AMOUNT-IN
           CALL 'AMTCALC' USING AMT-CALC-INTERFACE RETURNING WS-RC
           DISPLAY 'AMT-ZERO   RC=' WS-RC
             ' REASON=' FUNCTION TRIM(AMT-REASON)
           PERFORM 1000-SETUP
           MOVE 'D' TO AMT-DIRECTION
           MOVE '0000000002000' TO AMT-AMOUNT-IN
           CALL 'AMTCALC' USING AMT-CALC-INTERFACE RETURNING WS-RC
           DISPLAY 'AMT-OVERD  RC=' WS-RC
             ' REASON=' FUNCTION TRIM(AMT-REASON)
           PERFORM 1000-SETUP
           MOVE 9999999999999 TO AMT-BALANCE
           MOVE '0000000000001' TO AMT-AMOUNT-IN
           CALL 'AMTCALC' USING AMT-CALC-INTERFACE RETURNING WS-RC
           DISPLAY 'AMT-OVFL   RC=' WS-RC
             ' REASON=' FUNCTION TRIM(AMT-REASON)
           PERFORM 1000-SETUP
           MOVE 'X' TO AMT-DIRECTION
           CALL 'AMTCALC' USING AMT-CALC-INTERFACE RETURNING WS-RC
           DISPLAY 'AMT-DIR    RC=' WS-RC
             ' REASON=' FUNCTION TRIM(AMT-REASON)
           PERFORM 1000-SETUP
           MOVE 'ABCDEFGHIJKLM' TO AMT-AMOUNT-IN
           CALL 'AMTCALC' USING AMT-CALC-INTERFACE RETURNING WS-RC
           DISPLAY 'AMT-NUM    RC=' WS-RC
             ' REASON=' FUNCTION TRIM(AMT-REASON).
       IDENTIFICATION DIVISION.
       PROGRAM-ID. BYREF-SUB.
       DATA DIVISION.
       LINKAGE SECTION.
       01 L-A PIC X(5).
       PROCEDURE DIVISION USING L-A.
           MOVE 'BBBBB' TO L-A
           GOBACK.
       END PROGRAM BYREF-SUB.
       IDENTIFICATION DIVISION.
       PROGRAM-ID. BYCTR-SUB.
       DATA DIVISION.
       LINKAGE SECTION.
       01 L-A PIC X(5).
       PROCEDURE DIVISION USING L-A.
           MOVE 'CCCCC' TO L-A
           GOBACK.
       END PROGRAM BYCTR-SUB.
       IDENTIFICATION DIVISION.
       PROGRAM-ID. VAL-SUB.
       DATA DIVISION.
       LINKAGE SECTION.
       01 L-N PIC S9(9) COMP-5.
       PROCEDURE DIVISION USING BY VALUE L-N.
           ADD 1000 TO L-N
           GOBACK.
       END PROGRAM VAL-SUB.
       IDENTIFICATION DIVISION.
       PROGRAM-ID. STATIC-ACC.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 WS-COUNT PIC 9(4) VALUE 0.
       LINKAGE SECTION.
       01 L-RESULT PIC 9(4).
       PROCEDURE DIVISION USING L-RESULT.
           ADD 1 TO WS-COUNT
           MOVE WS-COUNT TO L-RESULT
           GOBACK.
       END PROGRAM STATIC-ACC.
       IDENTIFICATION DIVISION.
       PROGRAM-ID. INIT-ACC IS INITIAL.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 WS-COUNT PIC 9(4) VALUE 0.
       LINKAGE SECTION.
       01 L-RESULT PIC 9(4).
       PROCEDURE DIVISION USING L-RESULT.
           ADD 1 TO WS-COUNT
           MOVE WS-COUNT TO L-RESULT
           GOBACK.
       END PROGRAM INIT-ACC.
