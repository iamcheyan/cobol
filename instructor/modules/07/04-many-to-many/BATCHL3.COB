       PROCEDURE DIVISION.
       1000-MAIN.
           ACCEPT ACCOUNT-PATH FROM ENVIRONMENT "B03_ACCOUNT_FILE"
           ACCEPT MASTER-PATH FROM ENVIRONMENT "B03_MASTER_FILE"
           ACCEPT TX-PATH FROM ENVIRONMENT "B03_ACCEPT_FILE"
           ACCEPT SNAP-PATH FROM ENVIRONMENT "B03_SNAPSHOT_FILE"
           ACCEPT PREV-PATH FROM ENVIRONMENT "B03_PREVIOUS_FILE"
           ACCEPT SNAP-NORMAL-PATH
               FROM ENVIRONMENT "B03_SNAPSHOT_NORMAL"
           ACCEPT PREV-NORMAL-PATH
               FROM ENVIRONMENT "B03_PREVIOUS_NORMAL"
           ACCEPT ACCOUNT-FEED-PATH FROM ENVIRONMENT "B03_ACCOUNT_FEED"
           ACCEPT TX-FEED-PATH FROM ENVIRONMENT "B03_TX_FEED"
           ACCEPT SPOOL-PATH FROM ENVIRONMENT "B03_SPOOL_FILE"
           ACCEPT ELIGIBLE-MASTER-PATH FROM
               ENVIRONMENT "B03_ELIGIBLE_MASTER"
           ACCEPT ELIGIBLE-TX-PATH FROM ENVIRONMENT "B03_ELIGIBLE_TX"
           ACCEPT TOTALS-PATH FROM ENVIRONMENT "B03_TOTALS_FILE"
           ACCEPT STATUS-PATH FROM ENVIRONMENT "B03_STATUS_FILE"
           ACCEPT ISOLATION-PATH FROM ENVIRONMENT "B03_ISOLATION_FILE"
           ACCEPT CONTROL-PATH FROM ENVIRONMENT "B03_CONTROL_FILE"
           ACCEPT BUSINESS-DATE FROM ENVIRONMENT "B03_BUSINESS_DATE"
           ACCEPT L2-REJECT-PATH FROM ENVIRONMENT "B03_REJECT_FILE"
           ACCEPT L2-RAW-RC FROM ENVIRONMENT "B03_L2_RC"
           IF BUSINESS-DATE IS NOT NUMERIC
               PERFORM 9000-DATA-FAIL
           END-IF
           MOVE BUSINESS-DATE TO CURRENT-BUSINESS-DATE
           IF FUNCTION TEST-DATE-YYYYMMDD(
               CURRENT-BUSINESS-DATE) NOT = 0
               PERFORM 9000-DATA-FAIL
           END-IF
           PERFORM 1100-VALIDATE-SNAPSHOT
           PERFORM 1200-VALIDATE-PREVIOUS
           PERFORM 1300-SORT-ACCOUNTS
           PERFORM 1400-SORT-TRANSACTIONS
           PERFORM 1500-RUN-FOUR-WAY
           PERFORM 1600-READ-L2-REJECT-COUNT
           PERFORM 1700-WRITE-CONTROL
           IF RETURN-CODE NOT = 8 AND RETURN-CODE NOT = 12
               IF RETURN-CODE = 4 OR BUSINESS-DIFFERENCE = "Y" OR
                  L2-REJECT-COUNT > 0 OR
                  L2-RAW-RC = 4
                   MOVE 4 TO RETURN-CODE
               ELSE
                   MOVE 0 TO RETURN-CODE
               END-IF
           END-IF
           GOBACK.
       1100-VALIDATE-SNAPSHOT.
           OPEN INPUT SNAP-RAW
           IF SNAP-STATUS NOT = "00"
               PERFORM 9100-SYSTEM-FAIL
           END-IF
           OPEN OUTPUT SNAP-NORMAL
           IF SNAP-NORMAL-STATUS NOT = "00"
               PERFORM 9100-SYSTEM-FAIL
           END-IF
           MOVE 1 TO RAW-POSITION
           MOVE "N" TO RAW-EOF
           PERFORM UNTIL RAW-EOF = "Y"
               READ SNAP-RAW
                   AT END MOVE "Y" TO RAW-EOF
               END-READ
               EVALUATE SNAP-STATUS
                   WHEN "00"
                       IF SNAP-BYTE = X"0A"
                           IF RAW-POSITION NOT = 37
                               PERFORM 9000-DATA-FAIL
                           END-IF
                           MOVE RAW-RECORD(1:36)
                             TO CUSTOMER-SNAPSHOT-RECORD
                           PERFORM 1110-CHECK-SNAPSHOT
                           MOVE CUSTOMER-SNAPSHOT-RECORD
                             TO SNAP-NORMAL-RECORD
                           WRITE SNAP-NORMAL-RECORD
                           IF SNAP-NORMAL-STATUS NOT = "00"
                               PERFORM 9100-SYSTEM-FAIL
                           END-IF
                           MOVE 1 TO RAW-POSITION
                       ELSE
                           IF RAW-POSITION > 36 OR
                              FUNCTION ORD(SNAP-BYTE) < 33 OR
                              FUNCTION ORD(SNAP-BYTE) > 127
                               PERFORM 9000-DATA-FAIL
                           END-IF
                           MOVE SNAP-BYTE TO RAW-RECORD(RAW-POSITION:1)
                           ADD 1 TO RAW-POSITION
                       END-IF
                   WHEN "10" MOVE "Y" TO RAW-EOF
                   WHEN OTHER PERFORM 9100-SYSTEM-FAIL
               END-EVALUATE
           END-PERFORM
           IF RAW-POSITION NOT = 1
               PERFORM 9000-DATA-FAIL
           END-IF
           CLOSE SNAP-RAW SNAP-NORMAL
           IF SNAP-STATUS NOT = "00" OR
              SNAP-NORMAL-STATUS NOT = "00"
               PERFORM 9100-SYSTEM-FAIL
           END-IF.
       1110-CHECK-SNAPSHOT.
           IF SNAPSHOT-CUSTOMER-ID IS NOT NUMERIC OR
              SNAPSHOT-BUSINESS-DATE NOT = BUSINESS-DATE OR
              SNAPSHOT-LAYOUT-VERSION NOT = "001" OR
              SNAPSHOT-CUSTOMER-STATUS NOT = "A" AND NOT = "D" OR
              SNAPSHOT-MAX-ACCOUNT-COUNT IS NOT NUMERIC OR
              SNAPSHOT-MAX-CUSTOMER-BALANCE IS NOT NUMERIC OR
              SNAPSHOT-CUSTOMER-ID <= SNAP-PREVIOUS-KEY OR
              FUNCTION TEST-DATE-YYYYMMDD(
                  FUNCTION NUMVAL(SNAPSHOT-BUSINESS-DATE)) NOT = 0
               PERFORM 9000-DATA-FAIL
           END-IF
           MOVE SNAPSHOT-CUSTOMER-ID TO SNAP-PREVIOUS-KEY.
       1200-VALIDATE-PREVIOUS.
           MOVE FUNCTION INTEGER-OF-DATE(CURRENT-BUSINESS-DATE)
             TO DATE-ORDINAL
           MOVE FUNCTION DATE-OF-INTEGER(DATE-ORDINAL - 1)
             TO EXPECTED-PREVIOUS-DATE
           OPEN INPUT PREV-RAW
           IF PREV-STATUS NOT = "00"
               PERFORM 9100-SYSTEM-FAIL
           END-IF
           OPEN OUTPUT PREV-NORMAL
           IF PREV-NORMAL-STATUS NOT = "00"
               PERFORM 9100-SYSTEM-FAIL
           END-IF
           MOVE 1 TO RAW-POSITION
           MOVE "N" TO RAW-EOF
           PERFORM UNTIL RAW-EOF = "Y"
               READ PREV-RAW
                   AT END MOVE "Y" TO RAW-EOF
               END-READ
               EVALUATE PREV-STATUS
                   WHEN "00"
                       IF PREV-BYTE = X"0A"
                           IF RAW-POSITION NOT = 40
                               PERFORM 9000-DATA-FAIL
                           END-IF
                           MOVE RAW-RECORD(1:39)
                             TO PREVIOUS-DAY-RECORD
                           PERFORM 1210-CHECK-PREVIOUS
                           MOVE PREVIOUS-DAY-RECORD
                             TO PREV-NORMAL-RECORD
                           WRITE PREV-NORMAL-RECORD
                           IF PREV-NORMAL-STATUS NOT = "00"
                               PERFORM 9100-SYSTEM-FAIL
                           END-IF
                           MOVE 1 TO RAW-POSITION
                       ELSE
                           IF RAW-POSITION > 39 OR
                              FUNCTION ORD(PREV-BYTE) < 33 OR
                              FUNCTION ORD(PREV-BYTE) > 127
                               PERFORM 9000-DATA-FAIL
                           END-IF
                           MOVE PREV-BYTE TO RAW-RECORD(RAW-POSITION:1)
                           ADD 1 TO RAW-POSITION
                       END-IF
                   WHEN "10" MOVE "Y" TO RAW-EOF
                   WHEN OTHER PERFORM 9100-SYSTEM-FAIL
               END-EVALUATE
           END-PERFORM
           IF RAW-POSITION NOT = 1
               PERFORM 9000-DATA-FAIL
           END-IF
           CLOSE PREV-RAW PREV-NORMAL
           IF PREV-STATUS NOT = "00" OR
              PREV-NORMAL-STATUS NOT = "00"
               PERFORM 9100-SYSTEM-FAIL
           END-IF.
       1210-CHECK-PREVIOUS.
           IF PREVIOUS-CUSTOMER-ID IS NOT NUMERIC OR
              PREVIOUS-BUSINESS-DATE NOT = EXPECTED-PREVIOUS-DATE OR
              PREVIOUS-LAYOUT-VERSION NOT = "001" OR
              PREVIOUS-ACCOUNT-COUNT OF PREVIOUS-DAY-RECORD
                  IS NOT NUMERIC OR
              PREVIOUS-CLOSING-SIGN NOT = "+" AND NOT = "-" OR
              PREVIOUS-CLOSING-TOTAL IS NOT NUMERIC OR
              PREVIOUS-CUSTOMER-ID <= PREV-PREVIOUS-KEY OR
              FUNCTION TEST-DATE-YYYYMMDD(
                  FUNCTION NUMVAL(PREVIOUS-BUSINESS-DATE)) NOT = 0
               PERFORM 9000-DATA-FAIL
           END-IF
           MOVE PREVIOUS-CUSTOMER-ID TO PREV-PREVIOUS-KEY.
       1300-SORT-ACCOUNTS.
           OPEN OUTPUT ACCOUNT-FEED
           IF ACCOUNT-FEED-STATUS NOT = "00"
               PERFORM 9100-SYSTEM-FAIL
           END-IF
           SORT ACCOUNT-WORK ON ASCENDING KEY
               AS-CUSTOMER-ID AS-ACCOUNT-ID
               INPUT PROCEDURE 1310-LOAD-ACCOUNT-SORT
               OUTPUT PROCEDURE 1320-WRITE-ACCOUNT-SORT
           IF SORT-RETURN NOT = 0
               PERFORM 9100-SYSTEM-FAIL
           END-IF
           CLOSE ACCOUNT-FEED
           IF ACCOUNT-FEED-STATUS NOT = "00"
               PERFORM 9100-SYSTEM-FAIL
           END-IF.
       1310-LOAD-ACCOUNT-SORT.
           OPEN INPUT ACCOUNT-IN
           IF ACCOUNT-STATUS NOT = "00"
               PERFORM 9100-SYSTEM-FAIL
           END-IF
           OPEN INPUT MASTER-IN
           IF MASTER-STATUS NOT = "00"
               PERFORM 9100-SYSTEM-FAIL
           END-IF
           MOVE "N" TO ACCOUNT-EOF
           PERFORM UNTIL ACCOUNT-EOF = "Y"
               READ ACCOUNT-IN
                   AT END MOVE "Y" TO ACCOUNT-EOF
               END-READ
               EVALUATE ACCOUNT-STATUS
                   WHEN "00"
                       READ MASTER-IN
                           AT END PERFORM 9000-DATA-FAIL
                       END-READ
                       IF MASTER-STATUS NOT = "00" OR
                          MASTER-IN-RECORD(1:21) NOT =
                              ACCOUNT-IN-RECORD(1:21) OR
                          MASTER-IN-RECORD(36:12) NOT =
                              ACCOUNT-IN-RECORD(36:12)
                           PERFORM 9000-DATA-FAIL
                       END-IF
                       MOVE ACCOUNT-IN-RECORD TO ACCOUNT-REC
                       MOVE CUSTOMER-ID TO AS-CUSTOMER-ID
                       MOVE ACCOUNT-ID TO AS-ACCOUNT-ID
                       MOVE ACCOUNT-IN-RECORD TO AS-ORIGINAL
                       MOVE MASTER-IN-RECORD TO AS-CLOSING
                       RELEASE ACCOUNT-SORT-RECORD
                   WHEN "10" MOVE "Y" TO ACCOUNT-EOF
                   WHEN OTHER PERFORM 9100-SYSTEM-FAIL
               END-EVALUATE
           END-PERFORM
           READ MASTER-IN
               AT END CONTINUE
           END-READ
           IF MASTER-STATUS = "00"
               PERFORM 9000-DATA-FAIL
           END-IF
           CLOSE ACCOUNT-IN MASTER-IN
           IF ACCOUNT-STATUS NOT = "00" OR
              MASTER-STATUS NOT = "00"
               PERFORM 9100-SYSTEM-FAIL
           END-IF.
       1320-WRITE-ACCOUNT-SORT.
           MOVE "N" TO ACCOUNT-DONE
           PERFORM UNTIL ACCOUNT-DONE = "Y"
               RETURN ACCOUNT-WORK
                   AT END MOVE "Y" TO ACCOUNT-DONE
                   NOT AT END
                       MOVE SPACES TO ACCOUNT-FEED-RECORD
                       MOVE AS-CUSTOMER-ID TO
                           ACCOUNT-FEED-RECORD(1:8)
                       MOVE AS-ORIGINAL TO
                           ACCOUNT-FEED-RECORD(9:47)
                       MOVE AS-CLOSING TO
                           ACCOUNT-FEED-RECORD(56:47)
                       WRITE ACCOUNT-FEED-RECORD
                       IF ACCOUNT-FEED-STATUS NOT = "00"
                           PERFORM 9100-SYSTEM-FAIL
                       END-IF
               END-RETURN
           END-PERFORM.
       1400-SORT-TRANSACTIONS.
           OPEN OUTPUT TX-FEED
           IF TX-FEED-STATUS NOT = "00"
               PERFORM 9100-SYSTEM-FAIL
           END-IF
           SORT TX-WORK ON ASCENDING KEY
               TS-CUSTOMER-ID TS-ACCOUNT-ID TS-SEQUENCE
               TS-TRANSACTION-ID
               INPUT PROCEDURE 1410-LOAD-TX-SORT
               OUTPUT PROCEDURE 1420-WRITE-TX-SORT
           IF SORT-RETURN NOT = 0
               PERFORM 9100-SYSTEM-FAIL
           END-IF
           CLOSE TX-FEED
           IF TX-FEED-STATUS NOT = "00"
               PERFORM 9100-SYSTEM-FAIL
           END-IF.
       1410-LOAD-TX-SORT.
           OPEN INPUT ACCOUNT-IN
           IF ACCOUNT-STATUS NOT = "00"
               PERFORM 9100-SYSTEM-FAIL
           END-IF
           OPEN INPUT TX-IN
           IF TX-STATUS NOT = "00"
               PERFORM 9100-SYSTEM-FAIL
           END-IF
           MOVE "N" TO ACCOUNT-EOF TX-EOF
           READ ACCOUNT-IN
               AT END MOVE "Y" TO ACCOUNT-EOF
           END-READ
           IF ACCOUNT-STATUS NOT = "00" AND NOT = "10"
               PERFORM 9100-SYSTEM-FAIL
           END-IF
           IF ACCOUNT-STATUS = "00"
               MOVE ACCOUNT-IN-RECORD TO ACCOUNT-REC
           END-IF
           MOVE "N" TO TX-EOF
           PERFORM UNTIL TX-EOF = "Y"
               READ TX-IN
                   AT END MOVE "Y" TO TX-EOF
               END-READ
               EVALUATE TX-STATUS
                   WHEN "00"
                       MOVE TX-IN-RECORD TO TX-REC
                       PERFORM UNTIL ACCOUNT-EOF = "Y" OR
                           ACCOUNT-ID >= TX-ACCOUNT
                           READ ACCOUNT-IN
                               AT END MOVE "Y" TO ACCOUNT-EOF
                           END-READ
                           IF ACCOUNT-STATUS NOT = "00" AND NOT = "10"
                               PERFORM 9100-SYSTEM-FAIL
                           END-IF
                           IF ACCOUNT-STATUS = "00"
                               MOVE ACCOUNT-IN-RECORD TO ACCOUNT-REC
                           END-IF
                       END-PERFORM
                       IF ACCOUNT-EOF = "Y" OR
                          ACCOUNT-ID NOT = TX-ACCOUNT
                           PERFORM 9000-DATA-FAIL
                       END-IF
                       MOVE CUSTOMER-ID TO TS-CUSTOMER-ID
                       MOVE TX-ACCOUNT TO TS-ACCOUNT-ID
                       MOVE TX-SEQUENCE TO TS-SEQUENCE
                       MOVE TX-ID TO TS-TRANSACTION-ID
                       MOVE TX-IN-RECORD TO TS-RAW
                       RELEASE TX-SORT-RECORD
                   WHEN "10" MOVE "Y" TO TX-EOF
                   WHEN OTHER PERFORM 9100-SYSTEM-FAIL
               END-EVALUATE
           END-PERFORM
           CLOSE ACCOUNT-IN TX-IN
           IF ACCOUNT-STATUS NOT = "00" OR TX-STATUS NOT = "00"
               PERFORM 9100-SYSTEM-FAIL
           END-IF.
       1420-WRITE-TX-SORT.
           MOVE "N" TO TX-DONE
           PERFORM UNTIL TX-DONE = "Y"
               RETURN TX-WORK
                   AT END MOVE "Y" TO TX-DONE
                   NOT AT END
                       MOVE SPACES TO TX-FEED-RECORD
                       MOVE TS-CUSTOMER-ID TO TX-FEED-RECORD(1:8)
                       MOVE TS-RAW TO TX-FEED-RECORD(9:55)
                       WRITE TX-FEED-RECORD
                       IF TX-FEED-STATUS NOT = "00"
                           PERFORM 9100-SYSTEM-FAIL
                       END-IF
               END-RETURN
           END-PERFORM.
       1500-RUN-FOUR-WAY.
           OPEN INPUT ACCOUNT-CUSTOMER-IN TX-CUSTOMER-IN
               CUSTOMER-SNAPSHOT-IN PREVIOUS-DAY-IN
           IF ACCOUNT-CUSTOMER-STATUS NOT = "00" OR
              TX-CUSTOMER-STATUS NOT = "00" OR
              SNAPSHOT-IN-STATUS NOT = "00" OR
              PREVIOUS-IN-STATUS NOT = "00"
               PERFORM 9100-SYSTEM-FAIL
           END-IF
           OPEN OUTPUT ELIGIBLE-MASTER ELIGIBLE-TX
               CUSTOMER-TOTALS CUSTOMER-STATUS-OUT ISOLATION-OUT
           IF ELIGIBLE-MASTER-STATUS NOT = "00" OR
              ELIGIBLE-TX-STATUS NOT = "00" OR
              TOTALS-STATUS NOT = "00" OR
              STATUS-OUT-STATUS NOT = "00" OR
              ISOLATION-STATUS NOT = "00"
               PERFORM 9100-SYSTEM-FAIL
           END-IF
           MOVE SPACES TO TOTALS-RECORD
           STRING "customer_id,accounts,transactions,opening,"
               "credit,debit,closing" DELIMITED BY SIZE
               INTO TOTALS-RECORD
           END-STRING
           MOVE 62 TO OUTPUT-LENGTH
           WRITE TOTALS-RECORD
           PERFORM 1510-READ-ACCOUNT-CURSOR
           PERFORM 1520-READ-TX-CURSOR
           PERFORM 1530-READ-SNAPSHOT-CURSOR
           PERFORM 1540-READ-PREVIOUS-CURSOR
           PERFORM UNTIL ACCOUNT-CURSOR-EOF = "Y" AND
               TX-CURSOR-EOF = "Y" AND SNAPSHOT-CURSOR-EOF = "Y" AND
               PREVIOUS-CURSOR-EOF = "Y"
               MOVE "99999999" TO MINIMUM-KEY
               IF ACCOUNT-CURSOR-EOF NOT = "Y" AND
                  ACCOUNT-CURSOR(1:8) < MINIMUM-KEY
                   MOVE ACCOUNT-CURSOR(1:8) TO MINIMUM-KEY
               END-IF
               IF TX-CURSOR-EOF NOT = "Y" AND
                  TX-CURSOR(1:8) < MINIMUM-KEY
                   MOVE TX-CURSOR(1:8) TO MINIMUM-KEY
               END-IF
               IF SNAPSHOT-CURSOR-EOF NOT = "Y" AND
                  SNAPSHOT-CUSTOMER-ID < MINIMUM-KEY
                   MOVE SNAPSHOT-CUSTOMER-ID TO MINIMUM-KEY
               END-IF
               IF PREVIOUS-CURSOR-EOF NOT = "Y" AND
                  PREVIOUS-CUSTOMER-ID < MINIMUM-KEY
                   MOVE PREVIOUS-CUSTOMER-ID TO MINIMUM-KEY
               END-IF
               MOVE MINIMUM-KEY TO GROUP-KEY
               PERFORM 1550-RESET-GROUP
               PERFORM UNTIL ACCOUNT-CURSOR-EOF = "Y" OR
                   ACCOUNT-CURSOR(1:8) NOT = GROUP-KEY
                   MOVE ACCOUNT-CURSOR TO GROUP-ACCOUNT-ROW
                   PERFORM 1560-CONSUME-ACCOUNT
                   PERFORM 1510-READ-ACCOUNT-CURSOR
               END-PERFORM
               PERFORM UNTIL TX-CURSOR-EOF = "Y" OR
                   TX-CURSOR(1:8) NOT = GROUP-KEY
                   MOVE TX-CURSOR TO GROUP-TX-ROW
                   PERFORM 1570-CONSUME-TRANSACTION
                   PERFORM 1520-READ-TX-CURSOR
               END-PERFORM
               IF SNAPSHOT-CURSOR-EOF NOT = "Y" AND
                  SNAPSHOT-CUSTOMER-ID = GROUP-KEY
                   MOVE CUSTOMER-SNAPSHOT-RECORD TO SNAPSHOT-ROW
                   MOVE "Y" TO GROUP-HAS-SNAPSHOT
                   PERFORM 1530-READ-SNAPSHOT-CURSOR
               END-IF
               IF PREVIOUS-CURSOR-EOF NOT = "Y" AND
                  PREVIOUS-CUSTOMER-ID = GROUP-KEY
                   MOVE PREVIOUS-DAY-RECORD TO PREVIOUS-ROW
                   MOVE "Y" TO GROUP-HAS-PREVIOUS
                   PERFORM 1540-READ-PREVIOUS-CURSOR
               END-IF
               PERFORM 1580-DECIDE-GROUP
               PERFORM 1590-REPLAY-SPOOL
               PERFORM 1595-WRITE-CUSTOMER-ROWS
           END-PERFORM
           CLOSE ACCOUNT-CUSTOMER-IN TX-CUSTOMER-IN
               CUSTOMER-SNAPSHOT-IN PREVIOUS-DAY-IN
               ELIGIBLE-MASTER ELIGIBLE-TX CUSTOMER-TOTALS
               CUSTOMER-STATUS-OUT ISOLATION-OUT
           IF ACCOUNT-CUSTOMER-STATUS NOT = "00" OR
              TX-CUSTOMER-STATUS NOT = "00" OR
              SNAPSHOT-IN-STATUS NOT = "00" OR
              PREVIOUS-IN-STATUS NOT = "00" OR
              ELIGIBLE-MASTER-STATUS NOT = "00" OR
              ELIGIBLE-TX-STATUS NOT = "00" OR
              TOTALS-STATUS NOT = "00" OR
              STATUS-OUT-STATUS NOT = "00" OR
              ISOLATION-STATUS NOT = "00"
               PERFORM 9100-SYSTEM-FAIL
           END-IF.
       1510-READ-ACCOUNT-CURSOR.
           READ ACCOUNT-CUSTOMER-IN
               AT END MOVE "Y" TO ACCOUNT-CURSOR-EOF
               NOT AT END
                   IF ACCOUNT-CUSTOMER-STATUS NOT = "00"
                       PERFORM 9100-SYSTEM-FAIL
                   END-IF
                   MOVE ACCOUNT-CUSTOMER-RECORD TO ACCOUNT-CURSOR
           END-READ.
       1520-READ-TX-CURSOR.
           READ TX-CUSTOMER-IN
               AT END MOVE "Y" TO TX-CURSOR-EOF
               NOT AT END
                   IF TX-CUSTOMER-STATUS NOT = "00"
                       PERFORM 9100-SYSTEM-FAIL
                   END-IF
                   MOVE TX-CUSTOMER-RECORD TO TX-CURSOR
           END-READ.
       1530-READ-SNAPSHOT-CURSOR.
           READ CUSTOMER-SNAPSHOT-IN
               AT END MOVE "Y" TO SNAPSHOT-CURSOR-EOF
               NOT AT END
                   IF SNAPSHOT-IN-STATUS NOT = "00"
                       PERFORM 9100-SYSTEM-FAIL
                   END-IF
                   MOVE CUSTOMER-SNAPSHOT-RECORD TO SNAPSHOT-CURSOR
           END-READ.
       1540-READ-PREVIOUS-CURSOR.
           READ PREVIOUS-DAY-IN
               AT END MOVE "Y" TO PREVIOUS-CURSOR-EOF
               NOT AT END
                   IF PREVIOUS-IN-STATUS NOT = "00"
                       PERFORM 9100-SYSTEM-FAIL
                   END-IF
                   MOVE PREVIOUS-DAY-RECORD TO PREVIOUS-CURSOR
           END-READ.
       1550-RESET-GROUP.
           MOVE 0 TO GROUP-ACCOUNT-COUNT GROUP-TX-COUNT
               GROUP-CREDIT GROUP-DEBIT GROUP-OPENING
               GROUP-CLOSING EXPECTED-CLOSING
           MOVE "N" TO GROUP-HAS-ACCOUNT GROUP-HAS-TX
               GROUP-HAS-SNAPSHOT GROUP-HAS-PREVIOUS
           MOVE SPACES TO SNAPSHOT-ROW PREVIOUS-ROW
           OPEN OUTPUT GROUP-SPOOL
           IF SPOOL-STATUS NOT = "00"
               PERFORM 9100-SYSTEM-FAIL
           END-IF.
       1560-CONSUME-ACCOUNT.
           MOVE GROUP-ACCOUNT-ROW(9:47) TO ACCOUNT-REC
           IF ACCOUNT-ID = CURRENT-ACCOUNT-ID
               PERFORM 9000-DATA-FAIL
           END-IF
           MOVE ACCOUNT-ID TO CURRENT-ACCOUNT-ID
           MOVE 103 TO SPOOL-LENGTH
           MOVE "A" TO SPOOL-RECORD(1:1)
           MOVE GROUP-KEY TO SPOOL-RECORD(2:8)
           MOVE GROUP-ACCOUNT-ROW(9:94) TO SPOOL-RECORD(10:94)
           WRITE SPOOL-RECORD
           IF SPOOL-STATUS NOT = "00"
               PERFORM 9100-SYSTEM-FAIL
           END-IF
           COMPUTE ACCOUNT-OPENING = FUNCTION NUMVAL(OPENING-BALANCE)
               ON SIZE ERROR PERFORM 9000-DATA-FAIL
           END-COMPUTE
           IF BALANCE-SIGN = "-"
               COMPUTE SIGNED-TMP = 0 - ACCOUNT-OPENING
           ELSE
               MOVE ACCOUNT-OPENING TO SIGNED-TMP
           END-IF
           ADD SIGNED-TMP TO GROUP-OPENING
               TOTAL-OPENING ON SIZE ERROR PERFORM 9000-DATA-FAIL
           END-ADD
           COMPUTE ACCOUNT-CLOSING =
               FUNCTION NUMVAL(GROUP-ACCOUNT-ROW(78:13))
               ON SIZE ERROR PERFORM 9000-DATA-FAIL
           END-COMPUTE
           IF GROUP-ACCOUNT-ROW(77:1) = "-"
               COMPUTE SIGNED-TMP = 0 - ACCOUNT-CLOSING
           ELSE
               MOVE ACCOUNT-CLOSING TO SIGNED-TMP
           END-IF
           ADD SIGNED-TMP TO GROUP-CLOSING TOTAL-CLOSING
               ON SIZE ERROR PERFORM 9000-DATA-FAIL
           END-ADD
           ADD 1 TO GROUP-ACCOUNT-COUNT TOTAL-ACCOUNT-COUNT
               ON SIZE ERROR PERFORM 9000-DATA-FAIL
           END-ADD
           MOVE "Y" TO GROUP-HAS-ACCOUNT.
       1570-CONSUME-TRANSACTION.
           MOVE GROUP-TX-ROW(9:55) TO TX-REC
           MOVE 64 TO SPOOL-LENGTH
           MOVE "T" TO SPOOL-RECORD(1:1)
           MOVE GROUP-KEY TO SPOOL-RECORD(2:8)
           MOVE GROUP-TX-ROW(9:55) TO SPOOL-RECORD(10:55)
           WRITE SPOOL-RECORD
           IF SPOOL-STATUS NOT = "00"
               PERFORM 9100-SYSTEM-FAIL
           END-IF
           COMPUTE TX-AMOUNT = FUNCTION NUMVAL(TX-AMOUNT-RAW)
               ON SIZE ERROR PERFORM 9000-DATA-FAIL
           END-COMPUTE
           IF TX-DIR = "C"
               ADD TX-AMOUNT TO GROUP-CREDIT TOTAL-CREDIT
                   ON SIZE ERROR PERFORM 9000-DATA-FAIL
               END-ADD
           ELSE
               ADD TX-AMOUNT TO GROUP-DEBIT TOTAL-DEBIT
                   ON SIZE ERROR PERFORM 9000-DATA-FAIL
               END-ADD
           END-IF
           ADD 1 TO GROUP-TX-COUNT TOTAL-TX-COUNT
               ON SIZE ERROR PERFORM 9000-DATA-FAIL
           END-ADD
           MOVE "Y" TO GROUP-HAS-TX.
       1580-DECIDE-GROUP.
           MOVE SPACES TO CUSTOMER-REASON
           IF GROUP-HAS-ACCOUNT NOT = "Y"
               IF GROUP-HAS-SNAPSHOT = "Y" AND
                  GROUP-HAS-PREVIOUS = "Y"
                   MOVE "ORPHAN-SNAPSHOT-PREVIOUS" TO CUSTOMER-REASON
               ELSE
                   IF GROUP-HAS-SNAPSHOT = "Y"
                       MOVE "ORPHAN-SNAPSHOT" TO CUSTOMER-REASON
                   ELSE
                       MOVE "ORPHAN-PREVIOUS" TO CUSTOMER-REASON
                   END-IF
               END-IF
           ELSE
               IF GROUP-HAS-SNAPSHOT NOT = "Y"
                   MOVE "MISSING-SNAPSHOT" TO CUSTOMER-REASON
               ELSE
                   IF GROUP-HAS-PREVIOUS NOT = "Y"
                       MOVE "MISSING-PREVIOUS" TO CUSTOMER-REASON
                   ELSE
                       MOVE SNAPSHOT-ROW(20:1) TO CUSTOMER-STATUS
                       MOVE SNAPSHOT-ROW(21:3) TO SNAPSHOT-MAX-COUNT
                       MOVE SNAPSHOT-ROW(24:13) TO SNAPSHOT-MAX-BALANCE
                       MOVE PREVIOUS-ROW(20:6)
                         TO PREVIOUS-ACCOUNT-COUNT-N
                       MOVE PREVIOUS-ROW(26:1) TO TX-DIRECTION
                       COMPUTE PREVIOUS-CLOSING =
                           FUNCTION NUMVAL(PREVIOUS-ROW(27:13))
                           ON SIZE ERROR PERFORM 9000-DATA-FAIL
                       END-COMPUTE
                       IF TX-DIRECTION = "-"
                           COMPUTE PREVIOUS-CLOSING =
                               0 - PREVIOUS-CLOSING
                       END-IF
                       IF CUSTOMER-STATUS NOT = "A"
                           MOVE "CUSTOMER-INACTIVE" TO CUSTOMER-REASON
                       ELSE
                           IF GROUP-ACCOUNT-COUNT NOT =
                               PREVIOUS-ACCOUNT-COUNT-N
                               MOVE "ACCOUNT-COUNT-CHANGE"
                                 TO CUSTOMER-REASON
                           ELSE
                               IF GROUP-OPENING NOT = PREVIOUS-CLOSING
                                   MOVE "OPENING-MISMATCH"
                                     TO CUSTOMER-REASON
                               ELSE
                                   IF GROUP-ACCOUNT-COUNT >
                                       SNAPSHOT-MAX-COUNT
                                       MOVE "ACCOUNT-LIMIT"
                                         TO CUSTOMER-REASON
                                   END-IF
                               END-IF
                           END-IF
                       END-IF
                   END-IF
               END-IF
           END-IF
           COMPUTE EXPECTED-CLOSING =
               GROUP-OPENING + GROUP-CREDIT - GROUP-DEBIT
               ON SIZE ERROR PERFORM 9000-DATA-FAIL
           END-COMPUTE
           IF GROUP-HAS-ACCOUNT = "Y" AND
              GROUP-HAS-SNAPSHOT = "Y" AND
              GROUP-HAS-PREVIOUS = "Y" AND
              GROUP-CLOSING NOT = EXPECTED-CLOSING AND
              CUSTOMER-REASON = SPACES
               MOVE "CLOSING-MISMATCH" TO CUSTOMER-REASON
           END-IF
           IF GROUP-HAS-ACCOUNT = "Y" AND GROUP-HAS-SNAPSHOT = "Y"
               COMPUTE SNAPSHOT-MAX-BALANCE =
                   FUNCTION NUMVAL(SNAPSHOT-ROW(24:13))
               IF EXPECTED-CLOSING > SNAPSHOT-MAX-BALANCE AND
                  CUSTOMER-REASON = SPACES
                   MOVE "BALANCE-LIMIT" TO CUSTOMER-REASON
               END-IF
           END-IF
           CLOSE GROUP-SPOOL
           IF SPOOL-STATUS NOT = "00"
               PERFORM 9100-SYSTEM-FAIL
           END-IF
           IF CUSTOMER-REASON = SPACES
               MOVE "ELIGIBLE" TO CUSTOMER-DECISION
               ADD 1 TO TOTAL-ELIGIBLE-CUSTOMERS
               ADD GROUP-ACCOUNT-COUNT TO TOTAL-ELIGIBLE-ACCOUNT
               ADD GROUP-TX-COUNT TO TOTAL-ELIGIBLE-TX
               ADD GROUP-CREDIT TO TOTAL-ELIGIBLE-CREDIT
               ADD GROUP-DEBIT TO TOTAL-ELIGIBLE-DEBIT
           ELSE
               MOVE CUSTOMER-REASON TO CUSTOMER-DECISION
               ADD 1 TO TOTAL-ISOLATED-CUSTOMERS
               ADD GROUP-ACCOUNT-COUNT TO TOTAL-ISOLATED-ACCOUNT
               ADD GROUP-TX-COUNT TO TOTAL-ISOLATED-TX
               ADD GROUP-CREDIT TO TOTAL-ISOLATED-CREDIT
               ADD GROUP-DEBIT TO TOTAL-ISOLATED-DEBIT
               MOVE "Y" TO BUSINESS-DIFFERENCE
           END-IF.
       1590-REPLAY-SPOOL.
           OPEN INPUT GROUP-SPOOL
           IF SPOOL-STATUS NOT = "00"
               PERFORM 9100-SYSTEM-FAIL
           END-IF
           MOVE "N" TO GROUP-SPOOL-EOF
           PERFORM UNTIL GROUP-SPOOL-EOF = "Y"
               READ GROUP-SPOOL
                   AT END MOVE "Y" TO GROUP-SPOOL-EOF
                   NOT AT END
                       IF SPOOL-STATUS NOT = "00"
                           PERFORM 9100-SYSTEM-FAIL
                       END-IF
                       IF CUSTOMER-DECISION = "ELIGIBLE"
                           IF SPOOL-RECORD(1:1) = "A"
                               MOVE SPOOL-RECORD(57:47)
                                 TO ELIGIBLE-MASTER-RECORD
                               WRITE ELIGIBLE-MASTER-RECORD
                               IF ELIGIBLE-MASTER-STATUS NOT = "00"
                                   PERFORM 9100-SYSTEM-FAIL
                               END-IF
                           ELSE
                               MOVE SPOOL-RECORD(10:55)
                                 TO ELIGIBLE-TX-RECORD
                               WRITE ELIGIBLE-TX-RECORD
                               IF ELIGIBLE-TX-STATUS NOT = "00"
                                   PERFORM 9100-SYSTEM-FAIL
                               END-IF
                           END-IF
                       ELSE
                           MOVE SPACES TO ISOLATION-RECORD
                           IF SPOOL-RECORD(1:1) = "A"
                               STRING "ACCOUNT|" SPOOL-RECORD(2:8)
                                   "|" SPOOL-RECORD(10:47) "|"
                                   FUNCTION TRIM(CUSTOMER-REASON)
                                   DELIMITED BY SIZE
                                   INTO ISOLATION-RECORD
                               END-STRING
                           ELSE
                               STRING "TRANSACTION|" SPOOL-RECORD(2:8)
                                   "|" SPOOL-RECORD(10:55) "|"
                                   FUNCTION TRIM(CUSTOMER-REASON)
                                   DELIMITED BY SIZE
                                   INTO ISOLATION-RECORD
                               END-STRING
                           END-IF
                           WRITE ISOLATION-RECORD
                           IF ISOLATION-STATUS NOT = "00"
                               PERFORM 9100-SYSTEM-FAIL
                           END-IF
                       END-IF
               END-READ
           END-PERFORM
           CLOSE GROUP-SPOOL
           IF SPOOL-STATUS NOT = "00"
               PERFORM 9100-SYSTEM-FAIL
           END-IF.
       1595-WRITE-CUSTOMER-ROWS.
           IF GROUP-HAS-ACCOUNT NOT = "Y"
               IF GROUP-HAS-SNAPSHOT = "Y"
                   MOVE SPACES TO ISOLATION-RECORD
                   STRING "SNAPSHOT|" GROUP-KEY "|" SNAPSHOT-ROW
                       "|" FUNCTION TRIM(CUSTOMER-REASON)
                       DELIMITED BY SIZE INTO ISOLATION-RECORD
                   END-STRING
                   WRITE ISOLATION-RECORD
               END-IF
               IF GROUP-HAS-PREVIOUS = "Y"
                   MOVE SPACES TO ISOLATION-RECORD
                   STRING "PREVIOUS|" GROUP-KEY "|" PREVIOUS-ROW
                       "|" FUNCTION TRIM(CUSTOMER-REASON)
                       DELIMITED BY SIZE INTO ISOLATION-RECORD
                   END-STRING
                   WRITE ISOLATION-RECORD
               END-IF
           END-IF
           MOVE SPACES TO STATUS-RECORD
           STRING GROUP-KEY "|" FUNCTION TRIM(CUSTOMER-DECISION)
               "|" DELIMITED BY SIZE INTO STATUS-RECORD
           END-STRING
           WRITE STATUS-RECORD
           IF STATUS-OUT-STATUS NOT = "00"
               PERFORM 9100-SYSTEM-FAIL
           END-IF
           MOVE GROUP-ACCOUNT-COUNT TO COUNT-DISPLAY
           MOVE GROUP-TX-COUNT TO TOTAL-TX-EDIT
           MOVE GROUP-OPENING TO GROUP-OPEN-EDIT
           MOVE GROUP-CREDIT TO GROUP-CREDIT-EDIT
           MOVE GROUP-DEBIT TO GROUP-DEBIT-EDIT
           MOVE EXPECTED-CLOSING TO GROUP-CLOSE-EDIT
           MOVE SPACES TO LINE-BUILD
           MOVE 1 TO LINE-POSITION
           STRING GROUP-KEY ","
               FUNCTION TRIM(COUNT-DISPLAY LEADING) ","
               FUNCTION TRIM(TOTAL-TX-EDIT LEADING) ","
               FUNCTION TRIM(GROUP-OPEN-EDIT LEADING) ","
               FUNCTION TRIM(GROUP-CREDIT-EDIT LEADING) ","
               FUNCTION TRIM(GROUP-DEBIT-EDIT LEADING) ","
               FUNCTION TRIM(GROUP-CLOSE-EDIT LEADING)
               DELIMITED BY SIZE INTO LINE-BUILD
               WITH POINTER LINE-POSITION
           END-STRING
           MOVE LINE-BUILD TO TOTALS-RECORD
           COMPUTE OUTPUT-LENGTH = LINE-POSITION - 1
           WRITE TOTALS-RECORD
           IF TOTALS-STATUS NOT = "00"
               PERFORM 9100-SYSTEM-FAIL
           END-IF
           ADD 1 TO TOTAL-CUSTOMER-COUNT.
       1600-READ-L2-REJECT-COUNT.
           OPEN INPUT REJECT-RAW
           IF REJECT-STATUS NOT = "00"
               PERFORM 9100-SYSTEM-FAIL
           END-IF
           MOVE 0 TO L2-REJECT-COUNT
           MOVE "N" TO REJECT-EOF
           PERFORM UNTIL REJECT-EOF = "Y"
               READ REJECT-RAW
                   AT END MOVE "Y" TO REJECT-EOF
               END-READ
               EVALUATE REJECT-STATUS
                   WHEN "00"
                       IF REJECT-BYTE = X"0A"
                           ADD 1 TO L2-REJECT-COUNT
                       END-IF
                   WHEN "10" MOVE "Y" TO REJECT-EOF
                   WHEN OTHER PERFORM 9100-SYSTEM-FAIL
               END-EVALUATE
           END-PERFORM
           CLOSE REJECT-RAW
           IF REJECT-STATUS NOT = "00"
               PERFORM 9100-SYSTEM-FAIL
           END-IF.
       1700-WRITE-CONTROL.
           OPEN OUTPUT CONTROL-OUT
           IF CONTROL-STATUS NOT = "00"
               PERFORM 9100-SYSTEM-FAIL
           END-IF
           MOVE TOTAL-ACCOUNT-COUNT TO TOTAL-ACCOUNT-EDIT
           MOVE TOTAL-TX-COUNT TO TOTAL-TX-EDIT
           MOVE TOTAL-ELIGIBLE-ACCOUNT TO TOTAL-ELIGIBLE-ACCOUNT-EDIT
           MOVE TOTAL-ELIGIBLE-TX TO TOTAL-ELIGIBLE-TX-EDIT
           MOVE TOTAL-ISOLATED-ACCOUNT TO TOTAL-ISOLATED-ACCOUNT-EDIT
           MOVE TOTAL-ISOLATED-TX TO TOTAL-ISOLATED-TX-EDIT
           MOVE TOTAL-CREDIT TO TOTAL-CREDIT-EDIT
           MOVE TOTAL-DEBIT TO TOTAL-DEBIT-EDIT
           MOVE TOTAL-ELIGIBLE-CREDIT TO TOTAL-ELIGIBLE-CREDIT-EDIT
           MOVE TOTAL-ELIGIBLE-DEBIT TO TOTAL-ELIGIBLE-DEBIT-EDIT
           MOVE TOTAL-ISOLATED-CREDIT TO TOTAL-ISOLATED-CREDIT-EDIT
           MOVE TOTAL-ISOLATED-DEBIT TO TOTAL-ISOLATED-DEBIT-EDIT
           MOVE L2-REJECT-COUNT TO L2-REJECT-EDIT
           MOVE TOTAL-CUSTOMER-COUNT TO TOTAL-CUSTOMER-EDIT
           MOVE TOTAL-ELIGIBLE-CUSTOMERS
             TO TOTAL-ELIGIBLE-CUSTOMER-EDIT
           MOVE TOTAL-ISOLATED-CUSTOMERS
             TO TOTAL-ISOLATED-CUSTOMER-EDIT
           MOVE TOTAL-OPENING TO TOTAL-OPENING-EDIT
           MOVE TOTAL-CLOSING TO TOTAL-CLOSING-EDIT
           MOVE SPACES TO CONTROL-RECORD
           STRING "CUSTOMERS|"
               FUNCTION TRIM(TOTAL-CUSTOMER-EDIT LEADING)
               "|CUSTOMERS-ELIGIBLE|"
               FUNCTION TRIM(TOTAL-ELIGIBLE-CUSTOMER-EDIT LEADING)
               "|CUSTOMERS-ISOLATED|"
               FUNCTION TRIM(TOTAL-ISOLATED-CUSTOMER-EDIT LEADING)
               "|OPENING|" FUNCTION TRIM(TOTAL-OPENING-EDIT LEADING)
               "|CLOSING|" FUNCTION TRIM(TOTAL-CLOSING-EDIT LEADING)
               "|ACCOUNTS|" FUNCTION TRIM(TOTAL-ACCOUNT-EDIT LEADING)
               "|ELIGIBLE|"
               FUNCTION TRIM(TOTAL-ELIGIBLE-ACCOUNT-EDIT LEADING)
               "|ISOLATED|"
               FUNCTION TRIM(TOTAL-ISOLATED-ACCOUNT-EDIT LEADING)
               "|TX|" FUNCTION TRIM(TOTAL-TX-EDIT LEADING)
               "|TX-ELIGIBLE|"
               FUNCTION TRIM(TOTAL-ELIGIBLE-TX-EDIT LEADING)
               "|TX-ISOLATED|"
               FUNCTION TRIM(TOTAL-ISOLATED-TX-EDIT LEADING)
               "|CREDIT|" FUNCTION TRIM(TOTAL-CREDIT-EDIT LEADING)
               "|DEBIT|" FUNCTION TRIM(TOTAL-DEBIT-EDIT LEADING)
               "|ELIGIBLE-CREDIT|"
               FUNCTION TRIM(TOTAL-ELIGIBLE-CREDIT-EDIT LEADING)
               "|ELIGIBLE-DEBIT|"
               FUNCTION TRIM(TOTAL-ELIGIBLE-DEBIT-EDIT LEADING)
               "|ISOLATED-CREDIT|"
               FUNCTION TRIM(TOTAL-ISOLATED-CREDIT-EDIT LEADING)
               "|ISOLATED-DEBIT|"
               FUNCTION TRIM(TOTAL-ISOLATED-DEBIT-EDIT LEADING)
               "|L2-REJECT|" FUNCTION TRIM(L2-REJECT-EDIT LEADING)
               DELIMITED BY SIZE INTO CONTROL-RECORD
               ON OVERFLOW PERFORM 9000-DATA-FAIL
           END-STRING
           WRITE CONTROL-RECORD
           IF CONTROL-STATUS NOT = "00"
               PERFORM 9100-SYSTEM-FAIL
           END-IF
           CLOSE CONTROL-OUT
           IF CONTROL-STATUS NOT = "00"
               PERFORM 9100-SYSTEM-FAIL
           END-IF.
       9000-DATA-FAIL.
           MOVE 8 TO RETURN-CODE
           GOBACK.
       9100-SYSTEM-FAIL.
           MOVE 12 TO RETURN-CODE
           GOBACK.
