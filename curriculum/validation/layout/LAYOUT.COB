       IDENTIFICATION DIVISION.
       PROGRAM-ID. BYTE-LAYOUT.
       ENVIRONMENT DIVISION.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT BYTE-FILE ASSIGN TO 'layout.bin'
               ORGANIZATION IS SEQUENTIAL
               ACCESS MODE IS SEQUENTIAL
               FILE STATUS IS WS-STATUS.
       DATA DIVISION.
       FILE SECTION.
       FD BYTE-FILE.
       01 BYTE-RECORD PIC X(23).
       WORKING-STORAGE SECTION.
       01 WS-STATUS PIC XX.
       01 WS-LAYOUT.
          05 WS-DISPLAY PIC 9(5)V99 VALUE 123.45.
          05 WS-POSITIVE PIC S9(5)V99 COMP-3 VALUE 123.45.
          05 WS-NEGATIVE PIC S9(5)V99 COMP-3 VALUE -123.45.
          05 WS-BINARY PIC S9(9) COMP VALUE 123456.
          05 WS-NATIVE PIC S9(9) COMP-5 VALUE 123456.
       01 WS-LENGTH PIC 99.
       PROCEDURE DIVISION.
       1000-MAIN.
           OPEN OUTPUT BYTE-FILE
           IF WS-STATUS NOT = '00'
               MOVE 12 TO RETURN-CODE
               GOBACK
           END-IF
           MOVE WS-LAYOUT TO BYTE-RECORD
           WRITE BYTE-RECORD
           IF WS-STATUS NOT = '00'
               MOVE 12 TO RETURN-CODE
               GOBACK
           END-IF
           CLOSE BYTE-FILE
           IF WS-STATUS NOT = '00'
               MOVE 12 TO RETURN-CODE
               GOBACK
           END-IF
           DISPLAY 'LENGTHS=' WITH NO ADVANCING
           MOVE LENGTH OF WS-DISPLAY TO WS-LENGTH
           DISPLAY WS-LENGTH ',' WITH NO ADVANCING
           MOVE LENGTH OF WS-POSITIVE TO WS-LENGTH
           DISPLAY WS-LENGTH ',' WITH NO ADVANCING
           MOVE LENGTH OF WS-NEGATIVE TO WS-LENGTH
           DISPLAY WS-LENGTH ',' WITH NO ADVANCING
           MOVE LENGTH OF WS-BINARY TO WS-LENGTH
           DISPLAY WS-LENGTH ',' WITH NO ADVANCING
           MOVE LENGTH OF WS-NATIVE TO WS-LENGTH
           DISPLAY WS-LENGTH
           MOVE 0 TO RETURN-CODE
           GOBACK.
